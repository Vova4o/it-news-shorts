# Copy to .env and fill in real values. Nothing here is read by stage one code.
# Never commit a real .env file.

# --- runtime ---------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
TZ=Europe/Moscow

# --- scheduling ------------------------------------------------------------
DAILY_RUN_HOUR=9
DAILY_RUN_MINUTE=0
DAILY_RUN_TIMEZONE=Europe/Moscow
MAX_STORIES_PER_RUN=3

# --- limits ----------------------------------------------------------------
MAX_DAILY_BUDGET_USD=5.00
MAX_VIDEO_BUDGET_USD=1.00
MAX_ATTEMPTS=3
SHORTS_MIN_SECONDS=15
SHORTS_MAX_SECONDS=30

