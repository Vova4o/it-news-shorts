# Copy to .env and fill in real values.
# Never commit a real .env file.

# --- runtime ---------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
TZ=Europe/Moscow
AUTO_MIGRATE=true

# --- HTTP API & worker metrics ---------------------------------------------
API_PORT=8083
API_LISTEN_ADDR=:8081
WORKER_METRICS_ADDR=:9090

# --- scheduling ------------------------------------------------------------
DAILY_RUN_HOUR=9
DAILY_RUN_MINUTE=0
DAILY_RUN_TIMEZONE=Europe/Moscow
MAX_STORIES_PER_RUN=3

# --- limits ----------------------------------------------------------------
MAX_DAILY_BUDGET_USD=5.00
MAX_VIDEO_BUDGET_USD=1.00
MAX_ATTEMPTS=3
SHORTS_MIN_SECONDS=15
SHORTS_MAX_SECONDS=30

# --- PostgreSQL 16 ---------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=it_news
POSTGRES_USER=it_news_app
POSTGRES_PASSWORD=it_news_local_dev
POSTGRES_SSLMODE=disable
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_local_dev
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=1
POSTGRES_QUERY_TIMEOUT=5s

# --- Temporal --------------------------------------------------------------
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8082
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=it-news
TEMPORAL_TASK_QUEUE=IT_NEWS_QUEUE
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=temporal_local_dev

# --- MinIO (S3-compatible) -------------------------------------------------
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin_dev
MINIO_SECRET_KEY=minioadmin_dev_pass
MINIO_BUCKET=it-news-media
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_MAX_OBJECT_BYTES=268435456
MINIO_PRESIGN_TTL=15m

# --- placeholders for later stages & YouTube OAuth -------------------------
